# Flask se conecta a MySQL usando el nombre del servicio de Compose dentro de Docker.
DB_HOST=db

# Base de datos y usuario de MySQL para desarrollo local con Docker.
DB_NAME=noreste_grill
DB_USER=noreste_app
DB_PASSWORD=change_me_dev_password

# Password root usado solo por el healthcheck/acceso admin del contenedor MySQL.
MYSQL_ROOT_PASSWORD=change_me_root_password
